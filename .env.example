# ---------------------------------------------------------------------------
# 이 파일을 .env 로 복사해서 값을 채우세요. config.yaml 의 ${VAR} 자리에 들어갑니다.
# .env 는 git 에 올라가지 않습니다. 값이 없으면 config.yaml 의 기본값이 쓰입니다.
# ---------------------------------------------------------------------------

# --- LLM (사건 카드 요약·브리핑·중복 판정). 하나는 반드시 있어야 요약이 생성됩니다 ---
# 1순위 공급자: ollama | openrouter | claude
LLM_PROVIDER=ollama
# Ollama 서버 주소. 같은 머신이면 http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 사용할 모델 (ollama pull 로 먼저 받아두세요). 예: gpt-oss:120b, gpt-oss:20b, qwen3:8b
OLLAMA_MODEL=gpt-oss:120b
# OpenRouter 를 쓰거나 Ollama 실패 시 폴백으로 쓸 때. 키는 환경변수 또는 파일 경로 중 하나
OPENROUTER_API_KEY=
OPENROUTER_KEY_FILE=
# Anthropic 직접 호출 시
ANTHROPIC_API_KEY=

# --- 선택: 온체인 주소 라벨링(없어도 동작, 있으면 거래소·믹서 라벨이 붙음) ---
OKLINK_API_KEY=
OKLINK_KEY_FILE=

# --- 선택: 알림 ---
# Teams 수신 웹훅 URL (config.teams.enabled 가 true 일 때)
TEAMS_WEBHOOK_URL=
# Telegram (config.telegram.enabled 가 true 일 때)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 선택: 블랙리스트 대조용 저장소 경로(scam-address-data). 없으면 대조를 건너뜁니다 ---
CRIMIAL_REPO_DIR=../experience/scam-address-data

# --- 수집 시 소스에 보내는 연락처(User-Agent). 공개 API 예절상 채워두는 편이 좋습니다 ---
CONTACT_EMAIL=ops@example.com

# --- 결과를 git 에 자동 push 할 때 쓰는 remote 이름 (config.github.push: true 인 경우) ---
GIT_REMOTE=origin
